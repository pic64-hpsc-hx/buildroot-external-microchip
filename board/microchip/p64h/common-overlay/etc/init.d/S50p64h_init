#!/bin/sh

init_platform() {
	# start DHCP client for eth0 if the interface is up
	if [ -d /sys/class/net/eth0 ]; then
		STATE=$(cat /sys/class/net/eth0/operstate 2>/dev/null)
		if [ "$STATE" != "down" ] && [ "$STATE" != "unknown" ]; then
			udhcpc -i eth0 -b &
		fi
	fi
}

case "$1" in
	start|restart|reload)
		init_platform;;
	stop)
		;;
	*)
		echo "Usage: $0 {start|stop|restart|reload}"
		exit 1
esac
