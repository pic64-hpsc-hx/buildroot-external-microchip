#!/bin/sh

l2pf_init() {

	node_pattern="l2pf*"

	# L2 Prefetcher control registers values
	# uint64_t l2_basicCtrl = l2_ctrl_addr[hartid];
    # uint64_t l2_additionalCtrl = l2_basicCtrl + 4;
    # uint64_t l2_basicCtrl_data = is_enabled ? 0x15811: 0;
    # // new values from SiFive
    # // 0x38c84e -> 0x18c84e (disable vector load prefetch)	
	val1=0x15811
	val2=0x18c84e

	# Find and initialize all L2 Prefetchers, also perform sanity check (read back).
	for node in `find /proc/device-tree/soc/ -type d -iname $node_pattern | sort`; do

		cd $node
		base_addr=$(hexdump -e '"0x"' -e '8/1 "%02x""\n"' reg | head -1)

		echo "Set L2 Prefetcher values for node $(basename $node) "
		devmem $base_addr w $val1
		devmem $(($base_addr + 4)) w $val2

		echo "Read back L2 Prefetcher values "
		devmem $base_addr
		devmem $(($base_addr + 4))

	done
}

init_platform() {

	# mount devtmpfs to /dev if not already mounted to support disks
	mount -t devtmpfs devtmpfs /dev
	mount /dev/vda1 /opt

	# mount shm for shared memory (used by benchmarks)
	mkdir -p /dev/shm
	mount -t tmpfs /dev/shm

	# mount pts for pseudo terminals (used in ssh login)
	mkdir -p /dev/pts
 	mount devpts /dev/pts -t devpts

	#setup IP
	udhcpc -i eth0 -b &

    printf 'cat /proc/cpuinfo: \n '
    cat /proc/cpuinfo
	
	# L2 Prefetcher initialization for all Harts
	l2pf_init
}


auto_run() {
  if [ -f "/app/autorun.sh" ]; then
      /bin/sh /app/autorun.sh
  fi
}



case "$1" in
	start|restart|reload)
		init_platform;;
	stop)
		;;
	*)
		echo "Usage: $0 {start|stop|restart|reload}"
		exit 1
esac