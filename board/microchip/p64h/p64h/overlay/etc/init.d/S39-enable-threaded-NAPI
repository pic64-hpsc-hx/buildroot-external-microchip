#!/bin/sh
# /etc/init.d/S39-enable-threaded-napi

#
# We want to enable threaded NAPI to ethX before the interface is UP
# The script at SYSV level 39 to ensure interface not UP yet but exist
# But if the interface is UP the script will bring it DOWN and remember 
# to put it back to UP state
# This is needed mostly for PREEMPT_RT kernel so the interrupt thread will run
# on its own thread instead of the softirqd thread from the kernel
# Tests have shown more stability when threaded NAPI is activated when
# using PREEMPT_RT kernel
# for non-PREEMPT_RT kernel you might not need this
# the script will check if kernel is PREEMPT_RT to apply the threaded NAPI
# If you want to force threaded NAPI on non PREEMPT_RT kernel
# force by 'FORCE_THREADED_NAPI=1 S39-enable-threaded-napi start'
#

# list of affected interface - if you have more add them into IFACES list
IFACES="eth0 eth1 eth2 eth3"
FORCE_THREADED_NAPI="${FORCE_THREADED_NAPI:-1}"  # 1 = apply even if kernel is not PREEMPT_RT

is_preempt_rt()
{
    if [ -r /sys/kernel/realtime ] &&
       [ "$(cat /sys/kernel/realtime 2>/dev/null)" = "1" ]; then
        return 0
    fi
    case "$(uname -v 2>/dev/null)" in
        *PREEMPT_RT*|*PREEMPT-RT*) return 0 ;;
    esac
    return 1
}

iface_is_up()
{
    flags=$(cat "/sys/class/net/$1/flags" 2>/dev/null) || return 1
    [ $(( flags & 1 )) -ne 0 ]
}

enable_threaded_napi()
{
    iface="$1"
    attr="/sys/class/net/$iface/threaded"
    was_up=0
    rc=0

    if [ ! -d "/sys/class/net/$iface" ]; then
        echo "$iface: interface not found; skipping"
        return 0
    fi
    if [ ! -e "$attr" ]; then
        echo "$iface: threaded NAPI attribute not found; skipping"
        return 0
    fi
    if [ "$(cat "$attr" 2>/dev/null)" = "1" ]; then
        echo "$iface: threaded NAPI already enabled"
        return 0
    fi

    # Remember whether the interface was administratively UP
    if iface_is_up "$iface"; then
        was_up=1
        echo "$iface: bringing interface DOWN"
        if ! ip link set dev "$iface" down; then
            echo "$iface: failed to bring interface DOWN; skipping" >&2
            return 1
        fi
    fi

    # Apply threaded NAPI
    if ! echo 1 > "$attr"; then
        echo "$iface: failed to enable threaded NAPI" >&2
        rc=1
    fi

    # Restore the interface's original state
    if [ "$was_up" -eq 1 ]; then
        echo "$iface: restoring interface UP"
        if ! ip link set dev "$iface" up; then
            echo "$iface: failed to restore interface UP" >&2
            rc=1
        fi
    fi

    return "$rc"
}

start()
{
    if is_preempt_rt; then
        :
    elif [ "$FORCE_THREADED_NAPI" -eq 1 ]; then
        echo "kernel is not PREEMPT_RT; forcing threaded NAPI anyway"
    else
        echo "threaded NAPI not applied: kernel is not PREEMPT_RT"
        return 0
    fi

    status=0
    for i in $IFACES; do
        enable_threaded_napi "$i" || status=1
    done
    return "$status"
}

case "$1" in
    start)   start; exit $? ;;
    stop)    ;;
    restart) start; exit $? ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac
exit 0

