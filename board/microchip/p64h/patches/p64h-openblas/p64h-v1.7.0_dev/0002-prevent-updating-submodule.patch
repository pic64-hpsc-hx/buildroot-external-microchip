From a2891fcb4f4e14b58b177cc8382d6ff30cb15ea1 Mon Sep 17 00:00:00 2001
From: Eric Zhu <Eric.Zhu@microchip.com>
Date: Tue, 25 Mar 2025 08:26:52 -0700
Subject: [PATCH] tools/bin: prevent updating submodule

---
 tools/bin/build.sh | 2 --
 1 file changed, 2 deletions(-)

diff --git a/tools/bin/build.sh b/tools/bin/build.sh
index 29d1ca8b..448f81b0 100755
--- a/tools/bin/build.sh
+++ b/tools/bin/build.sh
@@ -60,8 +60,6 @@ while [ $# -gt 0 ]; do
 	shift
 done
 
-git submodule update --init --recursive openblas
-
 if [ "$CLEAN" -gt 0 ]; then
 	make -C "$OPENBLAS_SOURCE_DIR" clean HOSTCC=gcc TARGET=x280 CC=riscv64-unknown-linux-gnu-clang FC=riscv64-unknown-linux-gnu-gfortran NUM_THREADS="$NUM_THREADS"
 
-- 
2.43.5

