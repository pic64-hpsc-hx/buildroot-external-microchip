From d058de25a787d1b7595b54caed18c9ffa689007f Mon Sep 17 00:00:00 2001
From: Eric Zhu <Eric.Zhu@microchip.com>
Date: Tue, 25 Mar 2025 07:18:18 -0700
Subject: [PATCH] tools/bin: Add condition for overriding RISCV_PATH

---
 tools/bin/env.rc | 15 ++++++++-------
 1 file changed, 8 insertions(+), 7 deletions(-)

diff --git a/tools/bin/env.rc b/tools/bin/env.rc
index de6c746fd..7ab3cc98d 100644
--- a/tools/bin/env.rc
+++ b/tools/bin/env.rc
@@ -11,14 +11,15 @@ TOP_DIR=$(realpath ${BIN_DIR}/../..)
 OPENBLAS_SRC_DIR=${TOP_DIR}/openblas
 OPENBLAS_ARCHIVE_DIR=${TOP_DIR}/install
 
-if [ -f ${BIN_DIR}/env_local.rc ]; then
-    . ${BIN_DIR}/env_local.rc
-else
-    echo "...env_local.rc not found - skipping"
-fi
-
+if [ -z "$RISCV_PATH" ]; then
+	if [ -f ${BIN_DIR}/env_local.rc ]; then
+		. ${BIN_DIR}/env_local.rc
+	else
+		echo "...env_local.rc not found - skipping"
+	fi
 
-export RISCV_PATH=${TOOLS_BASE_DIR}/${TOOLS_DIR}/${RISCV_TOOLCHAIN_VER}
+	export RISCV_PATH=${TOOLS_BASE_DIR}/${TOOLS_DIR}/${RISCV_TOOLCHAIN_VER}
+fi
 
 # Check that RISCV_PATH is set correctly
 if [ ! -d ${RISCV_PATH}/bin ]; then
-- 
