From 278474b4c24f0742d716bf0ff3f72c40cb4f46ce Mon Sep 17 00:00:00 2001
From: Eric Zhu <Eric.Zhu@microchip.com>
Date: Mon, 24 Mar 2025 14:12:01 -0700
Subject: [PATCH] tools/bin: Added condition before overriding riscv_path

---
 tools/bin/env.rc | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/tools/bin/env.rc b/tools/bin/env.rc
index 82b8398..5d9ef83 100755
--- a/tools/bin/env.rc
+++ b/tools/bin/env.rc
@@ -15,10 +15,12 @@ else
 	echo "...dependencies.rc not found - skipping"
 fi
 
-if [ -f "$BIN_DIR"/env_local.rc ]; then
-	. "$BIN_DIR"/env_local.rc
-else
-	echo "...env_local.rc not found - skipping"
+if [ -z "$RISCV_PATH" ]; then
+	if [ -f "$BIN_DIR"/env_local.rc ]; then
+		. "$BIN_DIR"/env_local.rc
+	else
+		echo "...env_local.rc not found - skipping"
+	fi
 fi
 
 BUILD_DIR="$TOP_DIR"/build
-- 
2.43.5

