From 42a4c7140a0eeacf0ae2a8e3cee59b151757dad3 Mon Sep 17 00:00:00 2001
From: Eric Zhu <Eric.Zhu@microchip.com>
Date: Tue, 25 Mar 2025 07:42:31 -0700
Subject: [PATCH] tools/bin: Add condition for overriding RISCV_PATH

---
 tools/bin/env.rc | 24 +++++++++++++-----------
 1 file changed, 13 insertions(+), 11 deletions(-)

diff --git a/tools/bin/env.rc b/tools/bin/env.rc
index e2a84ad..fbe6764 100755
--- a/tools/bin/env.rc
+++ b/tools/bin/env.rc
@@ -8,19 +8,21 @@ BIN_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
 TOP_DIR=$(realpath "$BIN_DIR"/../..)
 export TOP_DIR
 
-. "$BIN_DIR/check_os_version.sh"
-TOOLS_DIR=P64hTools-1.6.0-x86_64-linux-$TOOL_VER
-if [[ -f $BIN_DIR/env_local.rc ]]; then
-	. "$BIN_DIR"/env_local.rc
-else
-	echo "...env_local.rc not found - skipping"
-fi
-RISCV_TOOLCHAIN_VER=riscv64-unknown-linux-toolsuite-1.6.0
+if [ -z "$RISCV_PATH" ]; then
+	. "$BIN_DIR/check_os_version.sh"
+	TOOLS_DIR=P64hTools-1.6.0-x86_64-linux-$TOOL_VER
+	if [[ -f $BIN_DIR/env_local.rc ]]; then
+		. "$BIN_DIR"/env_local.rc
+	else
+		echo "...env_local.rc not found - skipping"
+	fi
+	RISCV_TOOLCHAIN_VER=riscv64-unknown-linux-toolsuite-1.6.0
 
-# Override TOOLS_BASE_DIR to use your installed location for the Toolchain
-: "${TOOLS_BASE_DIR:="$TOP_DIR/install/"}"
+	# Override TOOLS_BASE_DIR to use your installed location for the Toolchain
+	: "${TOOLS_BASE_DIR:="$TOP_DIR/install/"}"
 
-export RISCV_PATH=$TOOLS_BASE_DIR/$TOOLS_DIR/$RISCV_TOOLCHAIN_VER
+	export RISCV_PATH=$TOOLS_BASE_DIR/$TOOLS_DIR/$RISCV_TOOLCHAIN_VER
+fi
 
 if [[ ! -d "$RISCV_PATH"/bin ]] && [[ -z "$SUPPRESS_TOOLCHAIN_WARNING" ]]; then
 	echo "WARNING: Tools directory $RISCV_PATH does not exist"
-- 
2.43.5

