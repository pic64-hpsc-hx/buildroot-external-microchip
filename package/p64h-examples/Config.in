config BR2_PACKAGE_P64H_EXAMPLES
	bool "PIC64-HPSC-HX Examples"
	depends on BR2_PACKAGE_P64H
	help
	  Linux example applications package for PIC64-HPSC-HX SoC.

config BR2_PACKAGE_P64H_EXAMPLES_HELLO
	bool "hello world"
	depends on BR2_PACKAGE_P64H_EXAMPLES
	help
	  Hello World application for PIC64-HPSC-HX SoC.

config BR2_PACKAGE_P64H_EXAMPLES_UIO_SHAREDMEM
	bool "uio sharedmem"
	depends on BR2_PACKAGE_P64H_EXAMPLES
	select BR2_PACKAGE_P64H_LKMS
	select BR2_PACKAGE_P64H_LKMS_UIO_SHAREDMEM_DRIVER
	help
	  This application demonstrates shared memory operations between
	  the application clusters on PIC64-HPSC-HX SoC.

	  This application utilizes UIO (Userspace I/O) framework to manage
	  shared memory operations on the PIC64-HPSC-HX SoC.
		
config BR2_PACKAGE_P64H_EXAMPLES_SPW
	bool "SpaceWire"
	depends on BR2_PACKAGE_P64H_EXAMPLES
	help
	  SpaceWire test application for PIC64-HPSC-HX SoC.

config BR2_PACKAGE_P64H_EXAMPLES_UTILS
	bool "utils"
	depends on BR2_PACKAGE_P64H_EXAMPLES
	help
	  Utility tool for PIC64-HPSC-HX SoC.

	  Enables file transfer between a host filesystem
	  and a Linux filesystem on the target device. It leverages 
	  p64h_semihost library internally.

config BR2_PACKAGE_P64H_EXAMPLES_TEST_AUTOMATION
	bool "test automation tools"
	depends on BR2_PACKAGE_P64H_EXAMPLES
	select BR2_PACKAGE_P64H_EXAMPLES_UTILS
	select BR2_PACKAGE_PYTHON3
	help
	  Utilities for helping to automate tests on the PIC64-HPSC-HX SoC.

config BR2_PACKAGE_P64H_EXAMPLES_TEST_AUTOMATION_QEMU
	bool "test automation tools qemu"
	depends on BR2_PACKAGE_P64H_EXAMPLES
	select BR2_PACKAGE_PYTHON3
	select BR2_PACKAGE_PYTHON3_PYC_ONLY
	select BR2_PACKAGE_PYTHON_PYTEST
	select BR2_PACKAGE_PYTHON_REGEX
	select BR2_PACKAGE_PYTHON_UNITTEST_XML_REPORTING
	help
	  Utilities for helping to automate tests on the PIC64-HPSC-HX SoC.