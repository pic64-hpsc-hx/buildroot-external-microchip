	help
	  hpcc benchmark for P64H SoC.

config BR2_PACKAGE_P64H_BENCHMARKS_HPEC_CHALLENGE
	bool "hpec_challenge"
	depends on BR2_PACKAGE_P64H_BENCHMARKS
	default y if BR2_PACKAGE_P64H_BENCHMARKS
	help
	  HPEC Challenge benchmark for P64H SoC.

