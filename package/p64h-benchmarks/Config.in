config BR2_PACKAGE_P64H_BENCHMARKS
	bool "PIC64-HPSC-HX Benchmarks"
	depends on BR2_PACKAGE_P64H
        select BR2_PACKAGE_HWLOC
	help
	  Linux benchmarks applications for PIC64-HPSC-HX SoC.

config BR2_PACKAGE_P64H_BENCHMARKS_ATOMICS
	bool "atomics"
	depends on BR2_PACKAGE_P64H_BENCHMARKS
	help
	  Atomics benchmark for PIC64-HPSC-HX SoC.

config BR2_PACKAGE_P64H_BENCHMARKS_COREMARK
	bool "coremark"
	depends on BR2_PACKAGE_P64H_BENCHMARKS
	help
	  Coremark benchmark for PIC64-HPSC-HX SoC.

config BR2_PACKAGE_P64H_BENCHMARKS_HACC
	bool "hacc"
	depends on BR2_PACKAGE_P64H_BENCHMARKS
	select BR2_PACKAGE_P64H_LIBS_OPENMP
	help
	  hacc benchmark for PIC64-HPSC-HX SoC.

config BR2_PACKAGE_P64H_BENCHMARKS_HPCC
	bool "hpcc"
	depends on BR2_PACKAGE_P64H_BENCHMARKS
	select BR2_PACKAGE_P64H_LIBS
	select BR2_PACKAGE_P64H_OPENBLAS
	select BR2_PACKAGE_P64H_OPENMPI
	select BR2_PACKAGE_P64H_LIBS_LIBGFORTRAN
	select BR2_PACKAGE_P64H_LIBS_LIBC
	select BR2_PACKAGE_P64H_LIBS_OPENMP
	select BR2_PACKAGE_OPENSSH
	select BR2_PACKAGE_IFUPDOWN_SCRIPTS
	select BR2_PACKAGE_LIBZLIB
	select BR2_PACKAGE_HWLOC
	help
	  hpcc benchmark for PIC64-HPSC-HX SoC.

