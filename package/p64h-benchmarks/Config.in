config BR2_PACKAGE_P64H_BENCHMARKS
	bool "p64h benchmarks"
	help
	  Linux benchmarks applications for P64H SoC.

config BR2_PACKAGE_P64H_BENCHMARKS_COREMARK
	bool "coremark"
	depends on BR2_PACKAGE_P64H_BENCHMARKS
	default y if BR2_PACKAGE_P64H_BENCHMARKS
	help
	  Coremark benchmark for P64H SoC.

config BR2_PACKAGE_P64H_BENCHMARKS_HACC
	bool "hacc"
	depends on BR2_PACKAGE_P64H_BENCHMARKS
	default y if BR2_PACKAGE_P64H_BENCHMARKS
	help
	  hacc benchmark for P64H SoC.

config BR2_PACKAGE_P64H_BENCHMARKS_HPCC
	bool "hpcc"
	depends on BR2_PACKAGE_P64H_BENCHMARKS
