menu "PIC64-HPSC-HX Applications"

config BR2_PACKAGE_P64H
    bool "P64H"
    help
      Container for P64H packages. Includes p64h-benchmarks, p64h-examples, p64h-libs, and p64h-lkms.

choice
    prompt "P64H Packages Source"
    depends on BR2_PACKAGE_P64H

config BR2_P64H_PACKAGE_LATEST_VERSION
    bool "Latest Version (p64h-v1.6.1)"
    help
      Downloads the latest tarball release of the p64h-linux-examples
      repository from https://github.com/pic64-hpsc-hx/p64h-linux-examples.

config BR2_P64H_PACKAGE_BITBUCKET
    bool "Bitbucket"
    help
      Downloads p64h-linux-examples source code from a custom Bitbucket repository.

config BR2_P64H_PACKAGE_LOCALDIR
    bool "Local Directory"
    help
      Copies p64h-linux-examples source code from a specified local directory.

config BR2_P64H_PACKAGE_CUSTOM_VERSION
    bool "Custom Version"
    help
      Downloads a custom tarball release of the p64h-linux-examples
      repository from https://github.com/pic64-hpsc-hx/p64h-linux-examples.

endchoice

config BR2_P64H_PACKAGE_BITBUCKET_SOURCE
    string "Bitbucket Repository URL"
    depends on BR2_P64H_PACKAGE_BITBUCKET
    help
      URL of the custom Bitbucket repository for p64h-linux-examples.

config BR2_P64H_PACKAGE_BITBUCKET_VERSION
    string "Bitbucket Repository Version"
    depends on BR2_P64H_PACKAGE_BITBUCKET
    help
      Version (branch, commit hash, tag) of the Bitbucket repository to be used. 

config BR2_P64H_PACKAGE_LOCALDIR_LOCATION
    string "Local p64h-linux-examples path"
    depends on BR2_P64H_PACKAGE_LOCALDIR
    help
      Path to the local p64h-linux-examples directory.

config BR2_P64H_PACKAGE_CUSTOM_VERSION_VALUE
    string "P64H-linux-examples Custom Version"
    depends on BR2_P64H_PACKAGE_CUSTOM_VERSION
    help
      Custom release version of p64h-linux-examples to be downloaded from 
      https://github.com/pic64-hpsc-hx/p64h-linux-examples.

if BR2_PACKAGE_P64H
    menu "P64H-benchmarks" 
    source "$BR2_EXTERNAL_MCHP_PATH/package/p64h-benchmarks/Config.in"
    endmenu

    menu "P64H-examples"
    source "$BR2_EXTERNAL_MCHP_PATH/package/p64h-examples/Config.in"
    endmenu

    menu "P64H-libs"
    source "$BR2_EXTERNAL_MCHP_PATH/package/p64h-libs/Config.in"
    endmenu
    
    menu "P64H-drivers"
    source "$BR2_EXTERNAL_MCHP_PATH/package/p64h-lkms/Config.in"
    endmenu
endif

endmenu
