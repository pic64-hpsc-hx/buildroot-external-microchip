#!/bin/sh
#
# Load the P64H watchdog driver and start the hardware watchdog daemon.
#

DRIVER="p64h_wdt"
WATCHDOG_DEV="/dev/watchdog0"
PIDFILE="/var/run/watchdog.pid"
# Watchdog sysfs directory (e.g. /sys/class/watchdog/watchdog0) exposing the
# timings the driver programmed.
WATCHDOG_SYS="/sys/class/watchdog/${WATCHDOG_DEV##*/}"
# -F: run in foreground so start-stop-daemon owns the pidfile. The -T (hardware
# reboot timeout) and -t (ping interval, set to half the timeout) values are
# derived at start time -- see start() -- so they always track what the driver
# actually set.
WATCHDOG_OPTS="-F"

start() {
	printf 'Loading kernel module %s: ' "$DRIVER"
	if modprobe "$DRIVER"; then
		echo "OK"
	else
		echo "FAIL"
		return 1
	fi

	if [ ! -e "$WATCHDOG_DEV" ]; then
		echo "watchdog device $WATCHDOG_DEV not present"
		return 1
	fi

	# Derive -T (hardware reboot timeout) and -t (feed interval) from the
	# driver's sysfs attributes instead of hardcoding them. These attributes
	# only exist once the module is loaded and the device is registered.
	timeout=$(cat "${WATCHDOG_SYS}/timeout" 2>/dev/null)
	if [ -z "$timeout" ]; then
		echo "cannot read watchdog timeout from ${WATCHDOG_SYS}"
		return 1
	fi
	ping=$(( timeout / 2 ))
	WATCHDOG_ARGS="${WATCHDOG_OPTS} -T ${timeout} -t ${ping} ${WATCHDOG_DEV}"

	printf 'Starting watchdog daemon: '
	start-stop-daemon -S -b -m -q -p "$PIDFILE" -x /sbin/watchdog -- $WATCHDOG_ARGS
	if [ $? -eq 0 ]; then
		echo "OK"
	else
		echo "FAIL"
		return 1
	fi
}

stop() {
	printf 'Stopping watchdog daemon: '
	start-stop-daemon -K -q -p "$PIDFILE"
	[ $? -eq 0 ] && echo "OK" || echo "FAIL"
	rm -f "$PIDFILE"
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart|reload)
		stop
		sleep 1
		start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac

exit $?
