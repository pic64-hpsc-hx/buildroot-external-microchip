#!/bin/sh

DRIVER="p64h_tfpga_spi_mem"

start() {
	printf 'Load kernel module %s: ' "$DRIVER"
	modprobe p64h_tfpga_spi_mem
	status=$?
	if [ "$status" -eq 0 ]; then
		echo "p64h_tfpga_spi_mem loaded"
	else
		echo "p64h_tfpga_spi_mem failed to load"
	fi
	return "$status"
}

case "$1" in
	start)
		"$1";;
	*)
		echo "Usage: $0 {start}"
		exit 1
esac
