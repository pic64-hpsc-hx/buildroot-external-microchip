#!/bin/sh

DRIVER="uio_mesa"

start() {
	printf 'Load kernel module %s: ' "$DRIVER"
	modprobe uio_mesa
	status=$?
	if [ "$status" -eq 0 ]; then
		echo "uio_mesa loaded"
	else
		echo "uio_mesa failed to load"
	fi
	return "$status"
}

case "$1" in
	start)
		"$1";;
	*)
		echo "Usage: $0 {start}"
		exit 1
esac