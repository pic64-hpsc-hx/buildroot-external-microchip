#!/bin/sh

DRIVER="uio_sharedmem"

start() {
	printf 'Load kernel module %s: ' "$DRIVER"
	modprobe $DRIVER
	status=$?
	if [ "$status" -eq 0 ]; then
		echo "$DRIVER loaded"
	else
		echo "$DRIVER failed to load"
	fi
	return "$status"
}

case "$1" in
	start)
		"$1";;
	*)
		echo "Usage: $0 {start}"
		exit 1
esac