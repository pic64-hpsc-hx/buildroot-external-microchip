#!/bin/sh

DRIVER="microchip-p64h_pcie"

start() {
	printf 'Load kernel module %s: ' "$DRIVER"
	modprobe p64h_pcie
	status=$?
	if [ "$status" -eq 0 ]; then
		echo "p64h_pcie loaded"
	else
		echo "p64h_pcie failed to load"
	fi
	return "$status"
}

case "$1" in
	start)
		"$1";;
	*)
		echo "Usage: $0 {start}"
		exit 1
esac