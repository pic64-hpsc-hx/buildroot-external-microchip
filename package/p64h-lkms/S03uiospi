#!/bin/sh

DRIVER="uio_spi"

start() {
	printf 'Load kernel module %s: ' "$DRIVER"
	modprobe spi-microchip-p64h_xspi
	status=$?
	if [ "$status" -eq 0 ]; then
		echo "uio_spi loaded"
	else
		echo "uio_spi failed to load"
	fi
	return "$status"
}

case "$1" in
	start)
		"$1";;
	*)
		echo "Usage: $0 {start}"
		exit 1
esac