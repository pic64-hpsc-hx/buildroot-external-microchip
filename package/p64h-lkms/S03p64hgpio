#!/bin/sh

DRIVER="microchip-p64h_gpio"

start() {
	printf 'Load kernel module %s: ' "$DRIVER"
	modprobe p64h_gpio
	status=$?
	if [ "$status" -eq 0 ]; then
		echo "p64h_gpio loaded"
	else
		echo "p64h_gpio failed to load"
	fi
	return "$status"
}

case "$1" in
	start)
		"$1";;
	*)
		echo "Usage: $0 {start}"
		exit 1
esac