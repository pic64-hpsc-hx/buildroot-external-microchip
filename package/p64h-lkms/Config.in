comment "p64h-lkms needs a Linux kernel to be built"
	depends on !BR2_LINUX_KERNEL

config BR2_PACKAGE_P64H_LKMS
	bool "PIC64-HPSC-HX Kernel Drivers"
	depends on BR2_PACKAGE_P64H
	depends on BR2_LINUX_KERNEL
	help
	  Add custom Linux kernel drivers package for PIC64-HPSC-HX SoC.

config BR2_PACKAGE_P64H_LKMS_UIO_SHAREDMEM_DRIVER
	bool "Enable uio sharedmem driver"
	depends on BR2_PACKAGE_P64H_LKMS
	help
      Enable support for the uio-sharedmem-driver, necessary for the uio-sharedmem
      userland application demo. This driver enables shared memory operations
	  between the application clusters using the UIO (Userspace I/O) framework.

config BR2_PACKAGE_P64H_LKMS_P64H_UIO_DRIVER
	bool "Enable uio p64h Generic driver"
	depends on BR2_PACKAGE_P64H_LKMS
	help
	  Enable support to P64H Application Complex UIO Generic Device
	  driver used to memory map any memory or peripheral in user space.

config BR2_PACKAGE_P64H_LKMS_XSPI_DRIVER
	bool "Enable P64H xspi driver"
	depends on BR2_PACKAGE_P64H_LKMS
	help
	  Enable support for P64H Application Complex XSPI driver.

config BR2_PACKAGE_P64H_LKMS_GPIO_DRIVER
	bool "Enable P64H gpio driver"
	depends on BR2_PACKAGE_P64H_LKMS
	help
	  Enable support for P64H Application Complex GPIO driver.

config BR2_PACKAGE_P64H_LKMS_WDT_DRIVER
	bool "Enable P64H watchdog driver"
	depends on BR2_PACKAGE_P64H_LKMS
	help
	  Enable support for P64H Application Complex watchdog driver.

config BR2_PACKAGE_P64H_LKMS_HPT_DRIVER
	bool "Enable P64H High Precision Timer driver"
	depends on BR2_PACKAGE_P64H_LKMS
	help
	  Enable support for P64H Application Complex High Precision Timer driver.

config BR2_PACKAGE_P64H_LKMS_IPC_DEMO_DRIVER
	bool "Enable P64H Inter Processor Communication(IPC) driver"
	depends on BR2_PACKAGE_P64H_LKMS
	help
	  Enable support for P64H Application Complex IPC driver.

config BR2_PACKAGE_P64H_LKMS_PCIE_DRIVER
	bool "Enable P64H PCIe driver"
	depends on BR2_PACKAGE_P64H_LKMS
	help
	  Enable support for P64H Application Complex PCIe bridge controller driver.

config BR2_PACKAGE_P64H_LKMS_X288_L2PF_DRIVER
        bool "Enable X288 L2 Perfetcher driver"
        depends on BR2_PACKAGE_P64H_LKMS
        help
          Enable support for P64H Application Complex X288 L2 Perfetcher driver.

config BR2_PACKAGE_P64H_LKMS_PIE_DRIVER
        bool "Enable P64H PIE driver"
        depends on BR2_PACKAGE_P64H_LKMS
        help
          Enable support for P64H Application Complex Packet Insert Extract
          (PIE) driver.

config BR2_PACKAGE_P64H_LKMS_RDMA_DRIVER
        bool "Enable P64H RDMA driver"
        depends on BR2_PACKAGE_P64H_LKMS
        help
          Enable support for P64H Application Complex RDMA driver.
