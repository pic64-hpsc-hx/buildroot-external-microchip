#!/bin/sh

DRIVER="microchip-x280-l2_pf"

start() {
	printf 'Load kernel module %s: ' "$DRIVER"
	modprobe x280_l2_pf
	status=$?
	if [ "$status" -eq 0 ]; then
		echo "x280_l2_pf loaded"
	else
		echo "x280_l2_pf failed to load"
	fi
	return "$status"
}

case "$1" in
	start)
		"$1";;
	*)
		echo "Usage: $0 {start}"
		exit 1
esac
