#!/bin/sh

DRIVER="microchip-x288-l2pf"

start() {
	printf 'Load kernel module %s: ' "$DRIVER"
	modprobe x288_l2pf
	status=$?
	if [ "$status" -eq 0 ]; then
		echo "x288_l2pf loaded"
	else
		echo "x288_l2pf failed to load"
	fi
	return "$status"
}

case "$1" in
	start)
		"$1";;
	*)
		echo "Usage: $0 {start}"
		exit 1
esac
