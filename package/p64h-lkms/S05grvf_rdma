#!/bin/sh

DRIVER="microchip-grvf_rdma"

start() {
	printf 'Load kernel module %s: ' "$DRIVER"
	if ! lsmod | grep -q p64h_pie; then
		modprobe p64h_pie
		pie_status=$?
		if [ "$pie_status" -ne 0 ]; then
			echo "p64h_pie failed to load"
			return "$pie_status"
		fi
	fi
	modprobe grvf_rdma
	status=$?
	if [ "$status" -eq 0 ]; then
		echo "grvf_rdma loaded"
	else
		echo "grvf_rdma failed to load"
	fi
	return "$status"
}

case "$1" in
	start)
		"$1";;
	*)
		echo "Usage: $0 {start}"
		exit 1
esac
