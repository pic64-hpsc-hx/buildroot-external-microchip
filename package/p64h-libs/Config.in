config BR2_PACKAGE_P64H_LIBS
	bool "PIC64-HPSC-HX Shared Libraries"
	depends on BR2_PACKAGE_P64H
	help
	  Enable this option to include shared libraries
	  and dependencies for PIC64-HPSC-HX SoC.

	  This package provides essential libraries and 
	  dependencies required for PIC64-HPSC-HX SoC.

	  If unsure, leave this option enabled.

source "$BR2_EXTERNAL_MCHP_PATH/package/p64h-openblas/Config.in"

source "$BR2_EXTERNAL_MCHP_PATH/package/p64h-openmpi/Config.in"

config BR2_PACKAGE_P64H_LIBS_LIBGFORTRAN
	bool "libgfortran"
	depends on BR2_PACKAGE_P64H_LIBS
	help
	  Enable this option to include libgfortran,
	  a library providing Fortran runtime support
	  for applications on the PIC64-HPSC-HX SoC.
	  
	  If unsure, leave this option enabled.

config BR2_PACKAGE_P64H_LIBS_LIBC
	bool "libc"
	depends on BR2_PACKAGE_P64H_LIBS
	help
	  Enable this option to include the C Library (libc),
	  providing fundamental routines for system programming
	  on the PIC64-HPSC-HX SoC.
	  
	  If unsure, leave this option enabled.

config BR2_PACKAGE_P64H_LIBS_OPENMP
	bool "openmp"
	depends on BR2_PACKAGE_P64H_LIBS
	help
	  Enable this option to include OpenMP,
	  a library providing OpenMP runtime support
	  for applications on the PIC64-HPSC-HX SoC.