# BR2_PACKAGE_P64H_LIBS_OPENBLAS is not set
# BR2_PACKAGE_P64H_LIBS_OPENMPI is not set
# BR2_PACKAGE_P64H_LIBS_LIBGFORTRAN is not set
# BR2_PACKAGE_P64H_LIBS_LIBC is not set
BR2_PACKAGE_P64H_LKMS=y
