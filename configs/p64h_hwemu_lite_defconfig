# BR2_PACKAGE_P64H_BENCHMARKS_HPEC_CHALLENGE is not set
# BR2_PACKAGE_P64H_BENCHMARKS_MICROBENCH is not set
# BR2_PACKAGE_P64H_BENCHMARKS_PERLIN is not set
# BR2_PACKAGE_P64H_BENCHMARKS_SPACEBENCH is not set
# BR2_PACKAGE_P64H_BENCHMARKS_STREAM is not set
