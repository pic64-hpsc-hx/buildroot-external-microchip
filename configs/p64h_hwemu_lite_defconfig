BR2_riscv=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_P64H=y
BR2_TOOLCHAIN_EXTERNAL_PREINSTALLED=y
BR2_TOOLCHAIN_EXTERNAL_PATH="$(RISCV_PATH)"
BR2_CCACHE=y
BR2_OPTIMIZE_S=y
BR2_PACKAGE_OVERRIDE_FILE="$(BR2_EXTERNAL_P64H_PACKAGE_OVERRIDE_FILE)"
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_MCHP_PATH)/board/microchip/p64h/patches"
BR2_TARGET_GENERIC_HOSTNAME="p64h-hwemu-lite"
BR2_TARGET_GENERIC_ISSUE="Welcome to PIC64 HPSC/HX HWEMU-LITE Buildroot"
BR2_ROOTFS_DEVICE_CREATION_STATIC=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_MCHP_PATH)/board/microchip/p64h/common-overlay/ $(BR2_EXTERNAL_MCHP_PATH)/board/microchip/p64h/hwemu_lite/overlay/"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_MCHP_PATH)/board/microchip/p64h/common-scripts/compress_image.sh"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_GIT=y
BR2_LINUX_KERNEL_CUSTOM_REPO_URL="git@github.com:pic64-hpsc-hx/linux.git"
BR2_LINUX_KERNEL_CUSTOM_REPO_VERSION="1c1e0c102f4fe030294f759d203b9b25f7348c4b"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_MCHP_PATH)/board/microchip/p64h/hwemu/linux.config"
BR2_PACKAGE_BUSYBOX_CONFIG="$(BR2_EXTERNAL_MCHP_PATH)/board/microchip/p64h/hwemu_lite/busybox.config"
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_HOST_E2FSPROGS=y
# BR2_TOOLCHAIN_EXTERNAL_P64H_COPY_TOOLCHAIN_SYSROOT is not set
BR2_PACKAGE_P64H=y
BR2_PACKAGE_P64H_PLATFORM="hwemu"
BR2_PACKAGE_P64H_EXAMPLES=y
BR2_PACKAGE_P64H_EXAMPLES_HELLO=y
BR2_PACKAGE_P64H_EXAMPLES_RPMI_RAS=y
BR2_PACKAGE_P64H_EXAMPLES_UIO_SHAREDMEM=y
BR2_PACKAGE_P64H_EXAMPLES_UTILS=y
BR2_PACKAGE_P64H_LKMS_P64H_UIO_DRIVER=y
BR2_PACKAGE_P64H_LKMS_GPIO_DRIVER=y
BR2_PACKAGE_P64H_LKMS_PCIE_DRIVER=y
BR2_PACKAGE_P64H_LKMS_X288_L2PF_DRIVER=y
