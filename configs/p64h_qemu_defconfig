BR2_riscv=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
BR2_TOOLCHAIN_EXTERNAL_PATH="$(RISCV_PATH)"
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="riscv64-unknown-linux-gnu"
BR2_TOOLCHAIN_EXTERNAL_HEADERS_6_2=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_GLIBC=y
# BR2_TOOLCHAIN_EXTERNAL_INET_RPC is not set
BR2_TOOLCHAIN_EXTERNAL_CXX=y
BR2_TOOLCHAIN_EXTERNAL_OPENMP=y
BR2_TOOLCHAIN_EXTERNAL_FORTRAN=y
BR2_TOOLCHAIN_EXTERNAL_GCC_13=y
BR2_TOOLCHAIN_EXTRA_LIBS="riscv64-unknown-linux-gnu-gdb riscv64-unknown-linux-gnu-gprof"
BR2_CCACHE=y
BR2_STRIP_EXCLUDE_FILES="hpsc_hello"
BR2_PACKAGE_OVERRIDE_FILE="$(BR2_EXTERNAL_MCHP_PATH)/board/microchip/p64h_qemu/override.mk"
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_MCHP_PATH)/board/microchip/p64h_qemu/patches"
BR2_TARGET_GENERIC_HOSTNAME="hpsc"
BR2_TARGET_GENERIC_ISSUE="Welcome to HPSC Buildroot"
BR2_ROOTFS_DEVICE_CREATION_STATIC=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_MCHP_PATH)/board/microchip/p64h_qemu/overlay/"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_MCHP_PATH)/board/microchip/p64h_qemu/post-image.sh"
BR2_PACKAGE_BUSYBOX_CONFIG="$(BR2_EXTERNAL_MCHP_PATH)/board/microchip/p64h_qemu/busybox.config"
#
# Linux Kernel
#
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_GIT=y
BR2_LINUX_KERNEL_CUSTOM_REPO_URL="git@bitbucket.microchip.com:hpsc/linux.git"
BR2_LINUX_KERNEL_CUSTOM_REPO_VERSION="b1faba9a91d8f0f45a13763b5a59591cd9afda7d"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_MCHP_PATH)/board/microchip/p64h_qemu/linux_6.6.9.config"

# GCC optimization levels
# optimize for size - -Os enables all -O2 optimizations except those that increase program size
BR2_OPTIMIZE_S=y  
# BR2_OPTIMIZE_2=y

BR2_GDB_VERSION_12=y
BR2_PACKAGE_LINUX_TOOLS_PERF=y
BR2_PACKAGE_HOST_GDB=y
BR2_PACKAGE_HOST_GDB_SIM=y
# Enable GDB on the target
BR2_PACKAGE_GDB_ARCH_SUPPORTS=y
BR2_PACKAGE_GDB=y
BR2_PACKAGE_GDB_DEBUGGER=y
BR2_PACKAGE_SSHFS=y
BR2_PACKAGE_HWLOC=y
BR2_PACKAGE_LIBCONFUSE=y
BR2_PACKAGE_LIBUEV=y
BR2_PACKAGE_LIBITE=y
BR2_PACKAGE_HAVEGED=y
BR2_PACKAGE_CPULOAD=y
BR2_PACKAGE_NUMACTL=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_SCHEDUTILS=y
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
BR2_PACKAGE_HOST_E2FSPROGS=y
# Do not startup the network service
BR2_PACKAGE_IFUPDOWN_SCRIPTS=n

#
# P64H Packages
#
BR2_PACKAGE_P64H_DEFAULT_GIT=y
#BR2_PACKAGE_P64H_CUSTOM_LOCAL=y
#BR2_PACKAGE_P64H_CUSTOM_LOCAL_PATH="./../p64h-linux-examples"
BR2_PACKAGE_P64H_EXAMPLES=y
BR2_PACKAGE_P64H_BENCHMARKS=y
