BR2_riscv=y
# if you want to run gdb inside qemu or protium then don't strip debugging symbols
#BR2_STRIP_strip=n
BR2_STRIP_strip=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_PREINSTALLED=y
BR2_TOOLCHAIN_EXTERNAL_P64H=y
BR2_TOOLCHAIN_EXTERNAL_PATH="$(RISCV_PATH)"
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="riscv64-unknown-linux-gnu"
BR2_TOOLCHAIN_EXTERNAL_HEADERS_6_6=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_GLIBC=y
# BR2_TOOLCHAIN_EXTERNAL_INET_RPC is not set
BR2_TOOLCHAIN_EXTERNAL_CXX=y
BR2_TOOLCHAIN_EXTERNAL_OPENMP=y
BR2_TOOLCHAIN_EXTERNAL_FORTRAN=y
BR2_TOOLCHAIN_EXTERNAL_GCC_14_2=y
BR2_TOOLCHAIN_EXTERNAL_GCC_VERSION_14=y
BR2_CCACHE=y
BR2_PACKAGE_OVERRIDE_FILE="$(BR2_EXTERNAL_P64H_PACKAGE_OVERRIDE_FILE)"
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_MCHP_PATH)/board/microchip/p64h/hwemu/patches"
BR2_TARGET_GENERIC_HOSTNAME="p64h-hwemu"
BR2_TARGET_GENERIC_ISSUE="Welcome to PIC64 HPSC/HX HWEMU Buildroot"
BR2_ROOTFS_DEVICE_CREATION_STATIC=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_MCHP_PATH)/board/microchip/p64h/hwemu/overlay/"
BR2_PACKAGE_BUSYBOX_CONFIG="$(BR2_EXTERNAL_MCHP_PATH)/board/microchip/p64h/hwemu/busybox.config"
#
# Kernel
#
BR2_LINUX_KERNEL=y
# BR2_LINUX_KERNEL_LATEST_VERSION is not set
# BR2_LINUX_KERNEL_LATEST_CIP_VERSION is not set
# BR2_LINUX_KERNEL_LATEST_CIP_RT_VERSION is not set
# BR2_LINUX_KERNEL_CUSTOM_VERSION is not set
# BR2_LINUX_KERNEL_CUSTOM_TARBALL is not set
BR2_LINUX_KERNEL_CUSTOM_GIT=y
# BR2_LINUX_KERNEL_CUSTOM_HG is not set
# BR2_LINUX_KERNEL_CUSTOM_SVN is not set
BR2_LINUX_KERNEL_CUSTOM_REPO_URL="ssh://git@bitbucket-bby-mirror01.devops.microchip.com/hpsc/linux.git"
BR2_LINUX_KERNEL_CUSTOM_REPO_VERSION="linux-6.12-mchp"
BR2_LINUX_KERNEL_VERSION="linux-6.12-mchp"
BR2_LINUX_KERNEL_PATCH=""
# BR2_LINUX_KERNEL_USE_DEFCONFIG is not set
# BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG is not set
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_MCHP_PATH)/board/microchip/p64h/hwemu/linux.config"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES=""
BR2_LINUX_KERNEL_CUSTOM_LOGO_PATH=""
BR2_LINUX_KERNEL_IMAGE=y
# BR2_LINUX_KERNEL_IMAGEGZ is not set
# BR2_LINUX_KERNEL_VMLINUX is not set
# BR2_LINUX_KERNEL_IMAGE_TARGET_CUSTOM is not set
BR2_LINUX_KERNEL_GZIP=y
# BR2_LINUX_KERNEL_LZ4 is not set
# BR2_LINUX_KERNEL_LZMA is not set
# BR2_LINUX_KERNEL_LZO is not set
# BR2_LINUX_KERNEL_XZ is not set
# BR2_LINUX_KERNEL_ZSTD is not set
# BR2_LINUX_KERNEL_DTS_SUPPORT is not set
# BR2_LINUX_KERNEL_INSTALL_TARGET is not set
# BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL is not set
# BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF is not set
# BR2_LINUX_KERNEL_NEEDS_HOST_PAHOLE is not set

# GCC optimization levels
# optimize for size - -Os enables all -O2 optimizations except those that increase program size
BR2_OPTIMIZE_S=y
# BR2_OPTIMIZE_2=y

BR2_GDB_VERSION_14=y
BR2_PACKAGE_LINUX_TOOLS_PERF=y
BR2_PACKAGE_HOST_GDB=y
BR2_PACKAGE_HOST_GDB_SIM=y
# Enable GDB on the target
BR2_PACKAGE_GDB_ARCH_SUPPORTS=y
BR2_PACKAGE_GDB=y
BR2_PACKAGE_GDB_DEBUGGER=y
# BR2_PACKAGE_SSHFS=y
BR2_PACKAGE_HWLOC=y
# BR2_PACKAGE_LIBCONFUSE=y
# BR2_PACKAGE_LIBUEV=y
# BR2_PACKAGE_LIBITE=y
BR2_PACKAGE_HAVEGED=y
# BR2_PACKAGE_CPULOAD=y
# BR2_PACKAGE_NUMACTL=y
# BR2_PACKAGE_UTIL_LINUX=y
# BR2_PACKAGE_UTIL_LINUX_SCHEDUTILS=y
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_HOST_E2FSPROGS=y
# Required for HPC Challenge benchmark
BR2_PACKAGE_IFUPDOWN_SCRIPTS=y

# Base Python3 installation
BR2_PACKAGE_HOST_GDB_PYTHON3=y
BR2_PACKAGE_PYTHON3=y

BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_OPENSSH_CLIENT=y
BR2_PACKAGE_OPENSSH_SERVER=y

#
# P64H Packages
#
BR2_PACKAGE_P64H=y
BR2_PACKAGE_P64H_EXAMPLES=y
# BR2_PACKAGE_P64H_EXAMPLES_HELLO is not set
# BR2_PACKAGE_P64H_EXAMPLES_UIO_SHAREDMEM is not set
BR2_PACKAGE_P64H_EXAMPLES_UTILS=y
BR2_PACKAGE_P64H_EXAMPLES_TEST_AUTOMATION=y
BR2_PACKAGE_P64H_BENCHMARKS=y
BR2_PACKAGE_P64H_BENCHMARKS_COREMARK=y
BR2_PACKAGE_P64H_BENCHMARKS_HACC=y
BR2_PACKAGE_P64H_BENCHMARKS_HPCC=y
# HPEC_CHALLENGE is 17 Mb; so exclude it to keep the rootfs size manageable
BR2_PACKAGE_P64H_BENCHMARKS_HPEC_CHALLENGE=n
BR2_PACKAGE_P64H_BENCHMARKS_MICROBENCH=y
BR2_PACKAGE_P64H_BENCHMARKS_PERLIN=y
BR2_PACKAGE_P64H_BENCHMARKS_SPACEBENCH=y
BR2_PACKAGE_P64H_BENCHMARKS_STREAM=y
BR2_PACKAGE_P64H_LIBS=y
BR2_PACKAGE_P64H_LIBS_OPENBLAS=y
BR2_PACKAGE_P64H_LIBS_OPENMPI=y
BR2_PACKAGE_P64H_LIBS_LIBGFORTRAN=y
BR2_PACKAGE_P64H_LIBS_LIBC=y
BR2_PACKAGE_P64H_LKMS=y
# BR2_PACKAGE_P64H_LKMS_UIO_SHAREDMEM_DRIVER is not set
# BR2_PACKAGE_P64H_LKMS_P64H_UIO_DRIVER is not set
BR2_PACKAGE_P64H_LKMS_UIO_MESA_DRIVER=y
# BR2_PACKAGE_P64H_LKMS_APPDMA_DRIVER is not set
# BR2_PACKAGE_P64H_LKMS_XSPI_DRIVER is not set
# BR2_PACKAGE_P64H_LKMS_GPIO_DRIVER is not set
