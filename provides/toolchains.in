config BR2_TOOLCHAIN_EXTERNAL_P64H
    bool "P64H Toolchain"
    depends on BR2_riscv
    depends on BR2_HOSTARCH = "x86_64"
    select BR2_TOOLCHAIN_EXTERNAL_PREINSTALLED
    select BR2_TOOLCHAIN_EXTERNAL_GCC_16
    select BR2_TOOLCHAIN_GCC_AT_LEAST_16
    select BR2_TOOLCHAIN_HEADERS_AT_LEAST_6_18
    select BR2_TOOLCHAIN_EXTERNAL_GLIBC
    select BR2_INSTALL_LIBSTDCPP
    select BR2_TOOLCHAIN_HAS_SSP
    select BR2_TOOLCHAIN_HAS_FORTRAN
    select BR2_TOOLCHAIN_HAS_OPENMP
    select BR2_TOOLCHAIN_EXTERNAL_CUSTOM_GLIBC
