if BR2_TOOLCHAIN_EXTERNAL_P64H

config BR2_TOOLCHAIN_EXTERNAL_PREFIX
	default BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX

config BR2_PACKAGE_PROVIDES_TOOLCHAIN_EXTERNAL
	default "toolchain-external-p64h"

config BR2_TOOLCHAIN_EXTERNAL_PATH
    default "$(RISCV_PATH)"

config BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX
	default "riscv64-unknown-linux-gnu"

config BR2_TOOLCHAIN_EXTERNAL_PREINSTALLED
    default y

config BR2_TOOLCHAIN_EXTERNAL_GCC_14
	default y
	select BR2_TOOLCHAIN_GCC_AT_LEAST_14

config BR2_TOOLCHAIN_EXTERNAL_HEADERS_6_6
	default y
	select BR2_TOOLCHAIN_HEADERS_AT_LEAST_6_6

config BR2_TOOLCHAIN_EXTERNAL_HAS_SSP
    default y
	select BR2_TOOLCHAIN_HAS_SSP

config BR2_TOOLCHAIN_EXTERNAL_CUSTOM_GLIBC
    default y
	select BR2_TOOLCHAIN_EXTERNAL_GLIBC

config BR2_TOOLCHAIN_EXTERNAL_CXX
    default y
	select BR2_INSTALL_LIBSTDCPP

config BR2_TOOLCHAIN_EXTERNAL_FORTRAN
    default y
	select BR2_TOOLCHAIN_HAS_FORTRAN

config BR2_TOOLCHAIN_EXTERNAL_OPENMP
    default y
	select BR2_TOOLCHAIN_HAS_OPENMP

endif
